# ============================================================
# Coffer .gitignore
# ============================================================
# 注意：本文件承担一项安全职责 —— 确保任何真实的密码库文件
#       都不会被意外提交。参见 docs/04-系统设计.md §8.4。

# ---------- 构建产物 ----------
target/
**/target/
*.rs.bk

# ---------- 开发工具 ----------
.idea/
.vscode/
.workbuddy/
*.iml
*.swp
*~

# ---------- macOS ----------
.DS_Store
._*

# ---------- Android ----------
android/.gradle/
android/local.properties
android/build/
android/app/build/
android/.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
# 签名材料：绝不入库
*.keystore
*.jks
keystore.properties

# ---------- macOS / Xcode ----------
macos/build/
macos/DerivedData/
macos/*.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserstate
*.moved-aside

# ---------- Python（工具脚本） ----------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------- 日志与诊断 ----------
*.log
logs/

# ============================================================
# 安全关键：真实密码库与导出文件一律不入库
# ============================================================
*.1pux
*.1pif
*.opvault/
*.kdbx
*.lvvault
*.csv
*.tsv

# 例外：仓库内的合成测试样本必须保留（它是用 tools/make_test_sample.py
# 生成的，不含任何真实数据，且带 "NOT real 1Password data" 标记）
# 注意 **：必须递归覆盖 tests/fixtures/csv/ 子目录（v0.2 教训：单层 * 使
# 夹具子目录全部被 *.csv 吞掉，从未入库，工作树回退即丢失）
!tests/fixtures/*.1pux
!tests/fixtures/**/*.csv

# ---------- 本地环境变量 ----------
.env
.env.local

# 真实 1PUX 样本：仅本地 M2 开发用，绝不入库
.local-samples/

# ---------- 本地 Agent/助手目录（按需不入库） ----------
.claude/
.codebuddy/

# ---------- 浏览器扩展（v2.3.0 G-C）----------
# 扩展 node_modules：仅 devDependencies（TypeScript/esbuild），构建产物 build.mjs 产出，不入库
/extension/node_modules/
/extension/tests-dist/
