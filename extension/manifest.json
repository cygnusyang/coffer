{
  "manifest_version": 3,
  "name": "Coffer 浏览器扩展",
  "version": "0.1.0",
  "description": "Coffer 登录信息填充与保存（E2E 会话，密文仅由本机 Coffer 解密，扩展不持有任何库密钥）",
  "default_locale": null,
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Coffer"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/capture.js", "content/fill.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ui/inline_menu.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "PENDING_COFFER_GECKO_ID"
    }
  },
  "key": "PENDING_COFFER_CHROME_EXTENSION_KEY_BASE64"
}
