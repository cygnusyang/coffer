{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "tests-dist",
    "rootDir": "."
  },
  "include": ["src/origin.ts", "src/crypto/**/*.ts", "src/protocol.ts", "src/pairing_state.ts", "src/tests/**/*.ts"]
}
