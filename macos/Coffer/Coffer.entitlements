<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox：零网络承诺（FR-14.5）的技术基础。
	     必须且只能出现以下权限；任何 com.apple.security.network.* 都是违规。 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- 相机权限（FR-5.3 TOTP QR 扫描，裁定 A，T09）：AVFoundation 在 App
	     Sandbox 下须显式声明 com.apple.security.device.camera 才能访问摄像头；
	     实际授予仍由 TCC 弹窗决定（NSCameraUsageDescription）。属裁定 A 的
	     必要配套；不涉网络，零网络承诺不受影响。若签名/真机启动遇 profile
	     未授权本 entitlement，需重跑 make_provisioning_profile.sh。 -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- CSV 导入：允许用户通过 NSOpenPanel 选择文件读取 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- 数据保护钥匙串访问组（TN3137：macOS 的 DP 钥匙串访问组列表
	     完全由本 entitlement 构建，缺失即 -34018；BUG-2 方案 A.2）。
	     TeamID 硬编码——codesign 不展开 $(AppIdentifierPrefix) 变量。
	     本 entitlement 属受限权限，须配合 provisioning profile
	     （tools/make_provisioning_profile.sh 生成）。无 network.*，
	     零网络承诺不受影响。 -->
	<key>keychain-access-groups</key>
	<array>
		<string>A6DS985SJJ.app.coffer.Coffer</string>
	</array>
</dict>
</plist>
