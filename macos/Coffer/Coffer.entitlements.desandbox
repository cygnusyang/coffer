<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 生产 App 去沙盒（Design Y，docs/31 r0.7）。
	     沙盒阻断两处容器外写入，真机实证即本行移除的原因：
	       - 浏览器 native messaging manifest：~/Library/Application Support/
	         {Google/Chrome,Microsoft Edge,Mozilla}/NativeMessagingHosts/
	         （沙盒下写入必然报「没有权限保存」）
	       - well-known broker UDS 目录：~/Library/Application Support/
	         Coffer/browser/（broker 由非沙盒嵌套 CLI spawn，App 侧仅建目录）
	     零网络承诺不再以 App Sandbox 为技术基础：改由 check_no_network
	     代码门禁 + 本 entitlement 无任何 com.apple.security.network.* 保证。
	     数据保护钥匙串仍由 keychain-access-groups 声明（见下）。
	     相机权限去沙盒后由 TCC + NSCameraUsageDescription 授予，无需
	     com.apple.security.device.camera（沙盒时代遗留）。 -->
	<!-- 数据保护钥匙串访问组（TN3137：macOS 的 DP 钥匙串访问组列表
	     完全由本 entitlement 构建，缺失即 -34018；BUG-2 方案 A.2）。
	     TeamID 硬编码——codesign 不展开 $(AppIdentifierPrefix) 变量。
	     本 entitlement 属受限权限，须配合 provisioning profile
	     （tools/make_provisioning_profile.sh 生成）。无 network.*，
	     零网络承诺不受影响。 -->
	<key>keychain-access-groups</key>
	<array>
		<string>A6DS985SJJ.app.coffer.Coffer</string>
	</array>
</dict>
</plist>
